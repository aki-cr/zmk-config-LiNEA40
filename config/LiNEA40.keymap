#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define MARK 1
#define CURSOR 3
#define FUNCTION 2
#define SCROLL 5
#define WIRELESS 6
#define GESTURE 8

// 長押しで別の動作になるキーの判定（2026-10-11 の Conductor の設定に合わせる: バランス / 200ms）
// quick-tap: タップしてすぐもう一度押して押し続けると、タップ側のキーが連続入力になる
&mt { flavor = "balanced"; tapping-term-ms = <200>; quick-tap-ms = <250>; };
&lt { flavor = "balanced"; tapping-term-ms = <200>; quick-tap-ms = <250>; };

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        // カーソルの加速（Conductor と同じく CPI 600 を基準に 1.3〜1.6倍）
        linea_accel_cursor: linea_accel_cursor {
            compatible = "linea,input-processor-accel";
            #input-processor-cells = <0>;
            min-factor-milli = <1300>;
            max-factor-milli = <1600>;
            speed-low = <4>;
            speed-high = <19>;
        };

        // トラボでのスクロールの細かさ: ゆっくり転がしたときだけ細かく（2倍）、速く弾いたときは等倍。
        // 1/20 だとゆっくり転がしたときにホイールの信号がまばらになり、カクカク詰まって感じるため（Conductor 比較で確認）
        linea_accel_scroll: linea_accel_scroll {
            compatible = "linea,input-processor-accel";
            #input-processor-cells = <0>;
            min-factor-milli = <800>;
            max-factor-milli = <1600>;
            speed-low = <2>;
            speed-high = <14>;
        };

        // トラボのスクロールを、エンコーダーと同じ「1回 ±1 段」の信号にそろえる（Mac Mouse Fix がエンコーダーと同じ自然な減速をかけるように）
        linea_scroll_tick: linea_scroll_tick {
            compatible = "linea,input-processor-tick";
            #input-processor-cells = <0>;
            max-carry = <3>;
        };

        // Gesture: Gesture レイヤーでトラボを上下左右に転がすと、そのレイヤーの I / , / J / L に置いたキーを1回押す
        linea_gesture: linea_gesture {
            compatible = "linea,input-processor-gesture";
            #input-processor-cells = <0>;
            layer = <GESTURE>;
            // 転がす方向 → Gesture レイヤーのこの位置のキーを押す（Conductor と同じ）
            // 上=I ⌃↓（アプリのウインドウ） / 下=, ⌃↑（Mission Control） / 左=J ⌃→ / 右=L ⌃←
            up = <7>;
            down = <27>;
            left = <16>;
            right = <18>;
            threshold = <40>;
            idle-ms = <250>;
        };

        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

// オートマウス（Conductor と同じ動き）: ボールを動かすとレイヤー1。ほかのキーを押すか、60秒操作が無いと抜ける。
// 直前のキー入力から 50ms 以内の動きでは有効にしない。19番（左クリック）を押しても抜けない
&zip_temp_layer {
    require-prior-idle-ms = <50>;
    excluded-positions = <19>;
};

&trackball_listener {
    input-processors = <&linea_accel_cursor>, <&zip_temp_layer MOUSE 60000>;

    gesture {
        layers = <GESTURE>;
        input-processors = <&linea_gesture>;
    };

    scroller {
        layers = <SCROLL>;
        // ドライバーのスクロールはやめて、ここで動きをスクロールに変える（加速をかけるため）。
        // 方向はドライバーのスクロールと同じ（上下は反転、左右はそのまま）
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 10>,
            <&linea_scroll_tick>;
        // 動いた量の 1/10 を段数にし、linea_scroll_tick で1回 ±1 段にそろえる（エンコーダーと同じ形）。
        // 1回に何段もまとめて送ると、Mac Mouse Fix の慣性が途切れたり急に止まったりした。ゆっくり2倍・15ms おき送信も不安定だった
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        L5_0 {
            bindings = <&mo 5>;
            key-positions = <17 18>;
            timeout-ms = <50>;
        };

        Gesture {
            bindings = <&mo GESTURE>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        BT_5_1 {
            bindings = <&bt BT_SEL 5>;
            key-positions = <0 10 20>;
            timeout-ms = <50>;
        };

        Boot_2 {
            bindings = <&bootloader>;
            key-positions = <8 24 4>;
            timeout-ms = <50>;
        };

        MB2_3 {
            bindings = <&mkp MB2>;
            key-positions = <18 19>;
            timeout-ms = <50>;
        };

        MB3_4 {
            bindings = <&mkp MB3>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        MB3_5 {
            bindings = <&mkp MB3>;
            key-positions = <17 19>;
            timeout-ms = <50>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "base";
            bindings = <
&mt LGUI Q           &kp W                &kp E                &kp R                &kp T                       &kp Y                &kp U                &kp I                &kp O                &kp P
&mt LCTRL A          &kp S                &kp D                &kp F                &kp G                       &kp H                &kp J                &kp K                &lt 5 L              &mt RCTRL ENTER
&mt LSHIFT Z         &kp X                &kp C                &kp V                &kp B                       &kp N                &kp M                &kp COMMA            &kp DOT              &mt RSHIFT BSPC
&mt LSHIFT TAB       &kp LALT             &mt LGUI LANG2       &kp INS              &lt 1 SPACE          &lt 2 BSPC            &lt 2 ENTER          &lt 3 LANG1          &mt LGUI LANG2       &kp C_VOL_DN         &kp C_VOL_UP
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        symbol_layer {
            display-name = "symbol";
            bindings = <
&kp EXCL             &kp AT               &kp HASH             &kp DLLR             &kp PRCNT                   &kp CARET            &kp AMPS             &kp STAR             &kp LPAR             &kp RPAR
&kp LS(LG(N3))       &kp LS(LG(N4))       &kp LS(LG(N5))       &none                &kp UNDER                   &kp MINUS            &kp EQUAL            &kp LBKT             &kp RBKT             &kp MINUS
&kp LSHIFT           &none                &kp LC(LS(LA(LG(M)))) &kp EXCL             &kp QMARK                   &none                &none                &kp SEMI             &kp SQT              &kp GRAVE
&kp ESC              &none                &none                &trans               &none                &mo 6                 &kp TAB              &none                &kp LGUI             &none                &none
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        number_layer {
            display-name = "number";
            bindings = <
&kp F1               &kp F2               &kp F3               &kp F4               &kp F5                      &kp N1               &kp N2               &kp N3               &kp N0               &kp EQUAL
&kp F6               &kp F7               &kp F8               &kp F9               &kp F10                     &kp N4               &kp N5               &kp N6               &kp PLUS             &kp MINUS
&kp F11              &kp F12              &trans               &trans               &trans                      &kp N7               &kp N8               &kp N9               &kp STAR             &kp FSLH
&kp LSHIFT           &kp LCTRL            &kp LALT             &trans               &none                &none                 &kp DOT              &kp N0               &kp LGUI             &none                &none
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        move_layer {
            display-name = "move";
            bindings = <
&trans               &trans               &trans               &trans               &trans                      &kp LC(UP)           &kp LC(LEFT)         &kp UP               &kp LC(RIGHT)        &kp LC(DOWN)
&kp TAB              &trans               &trans               &trans               &trans                      &kp LC(LS(TAB))      &kp LEFT             &kp DOWN             &kp RIGHT            &mt RALT LC(TAB)
&trans               &trans               &trans               &trans               &trans                      &kp LC(A)            &kp LG(LEFT)         &none                &kp LG(RIGHT)        &kp LC(E)
&kp LSHIFT           &none                &none                &trans               &none                &none                 &none                &none                &kp LGUI             &kp C_BRI_DN         &kp C_BRI_UP
            >;
        };

        mouse_layer {
            display-name = "mouse";
            bindings = <
&trans               &trans               &trans               &trans               &trans                      &trans               &trans               &trans               &trans               &trans
&trans               &trans               &trans               &trans               &trans                      &trans               &trans               &trans               &trans               &mkp MB1
&trans               &trans               &trans               &trans               &trans                      &trans               &trans               &trans               &trans               &trans
&trans               &trans               &trans               &trans               &trans               &trans                &trans               &trans               &trans               &trans               &trans
            >;
        };

        scroll_layer {
            display-name = "scroll";
            bindings = <
&none                &none                &none                &none                &none                       &none                &none                &none                &none                &none
&none                &none                &none                &none                &none                       &none                &none                &none                &none                &none
&none                &none                &none                &none                &none                       &none                &none                &none                &none                &none
&none                &none                &none                &trans               &none                &none                 &none                &none                &none                &none                &none
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        setting_layer {
            display-name = "setting";
            bindings = <
&none                &none                &none                &none                &none                       &bt BT_SEL 0         &bt BT_SEL 1         &bt BT_SEL 2         &bt BT_SEL 3         &bt BT_SEL 4
&none                &none                &none                &none                &none                       &none                &trans               &trans               &tog 7               &none
&none                &trans               &trans               &trans               &none                       &none                &none                &none                &none                &none
&none                &none                &none                &trans               &none                &none                 &none                &bootloader          &studio_unlock       &bt BT_CLR           &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        Precision_layer {
            display-name = "Precision";
            bindings = <
&none                &none                &none                &none                &none                       &trans               &none                &none                &none                &none
&trans               &none                &none                &none                &none                       &none                &none                &none                &trans               &mkp MB1
&trans               &none                &trans               &trans               &none                       &none                &none                &none                &none                &trans
&trans               &none                &none                &trans               &trans               &trans                &trans               &trans               &trans               &none                &tog 7
            >;
        };
        Gesture_layer {
            display-name = "Gesture";
            bindings = <
&none                &none                &none                &none                &none                       &none                &none                &kp LC(DOWN)         &none                &none
&none                &none                &none                &none                &none                       &none                &kp LC(RIGHT)        &none                &kp LC(LEFT)         &none
&none                &none                &none                &none                &none                       &none                &none                &kp LC(UP)           &none                &none
&none                &none                &none                &none                &none                &none                 &none                &none                &none                &none                &none
            >;
        };
    };
};
